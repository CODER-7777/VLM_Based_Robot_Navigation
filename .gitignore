# Ignore unnecessary files for the UGP repo

# Simulator caches and binaries
*.bin
*.so
*.dylib
*.dll
*.exe
build/
bin/

# Dataset and media files (except small demos)
*bro ad4
*.mkv
*.avi
*.bag
*.pcd
*.png
*.jpg
*.jpeg
# If you want to include small screenshots, you can un-ignore png/jpg 
# by commenting them out or using !path/to/image.png
!image.png
!Screenshot*.png
!1.png

# Python
__pycache__/
*.pyc
.env
.venv
venv/

# IDEs and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Retained local source archives; provenance is recorded in review documentation.
/reference_materials/archive/*.tar.gz

# Selected small presentation figures are intentional evidence artifacts.
!/docs/mid_evaluation/figures/*.png
!/docs/mid_evaluation/figures/*.jpg

# Independent slide diagrams and selected small current evidence images.
!/docs/mid_evaluation/diagrams/*.png
!/docs/mid_evaluation/presentation/assets/*.png
!/docs/mid_evaluation/presentation/assets/*.jpg

# Generated research inputs and outputs remain local; tracked historical files
